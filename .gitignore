# .gitignore for InstaGuest
# Automatically configured for optimal Git cleanliness

# Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# IDEs and Text Editors
.idea/
*.iws
*.iml
*.ipr
out/
.vscode/.history/
.vscode/*.log
*.sublime-workspace
*~
*.swp
*.swo
*.bak
*.tmp

# Environment Variables and Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Tool Caches
graphify-out/cache/

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
*.egg
.coverage
htmlcov/
